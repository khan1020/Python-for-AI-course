# ==============================================================================
# Database Configuration
# NOTE: Your local PostgreSQL on this machine is listening on PORT 9000 (not 5432)!
# Replace 'yourpassword' and 'yourdbname' with your actual PostgreSQL credentials.
# Or paste a cloud Postgres URL (e.g. Neon.tech / Supabase).
# ==============================================================================
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:9000/yourdbname

# ==============================================================================
# LLM Provider Configuration
# The code in modules/ai_team/graph.py defaults to OpenRouter ("openrouter").
# OpenRouter is OpenAI-compatible and can route requests to suitable free models.
# Get a key at: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here
# OPENROUTER_MODEL=openrouter/free
# MAX_OUTPUT_TOKENS=4096
#
# To use Groq instead, set LLM_PROVIDER=groq.
# Get a free key at: https://console.groq.com/keys
# ==============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: If you run local models via Ollama
OLLAMA_MODEL=qwen2.5-coder:7b

# ==============================================================================
# Web Search Tool (Optional)
# If provided, the planner agent can search web documentation for libraries.
# NOTE: Fixed typo from 'TAVILY_APY' to 'TAVILY_API_KEY'.
# Get a free key at: https://app.tavily.com
# ==============================================================================
TAVILY_API_KEY=tvly-your_tavily_key_here
