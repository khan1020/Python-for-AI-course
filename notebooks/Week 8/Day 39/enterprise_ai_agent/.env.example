# Copy to .env and add your OpenRouter API key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OpenRouter's free router selects a model that supports the agent's tools.
CHAT_MODEL=openrouter/free
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free

# Optional alternatives for local Ollama or Groq.
OLLAMA_MODEL=qwen3:4b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
